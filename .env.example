# Neon connection strings (get both from the Neon dashboard -> Connection Details)
# DATABASE_URL: pooled connection (used by the running app), must include ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# DIRECT_URL: unpooled connection (used by Prisma for migrations/db push)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_SITE_URL="https://yourdomain.vercel.app"
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="CHANGE_THIS_PASSWORD"
